datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

type SubCategory {
  id          String
  name        String
  slug        String
  description String?
}

type ProductColor {
  name String
  hex  String
}

type OrderProduct {
  id     String
  name   String
  price  Float
  images String[]
  slug   String
  code   String?
}

type OrderItem {
  product       OrderProduct
  selectedColor String
  selectedSize  String
  quantity      Int
}

type ShippingAddress {
  fullName   String
  phone      String
  street     String
  city       String
  country    String
  postalCode String
}

type CartItem {
  productId     String
  selectedColor String
  selectedSize  String
  quantity      Int
}

model BlockedIp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ip        String   @unique
  reason    String   @default("Security Violation / Suspicious Activity")
  blockedBy String   @default("Administrator")
  blockedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blockedips")
}

model Category {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  categoryId    String        @unique @map("id")
  name          String
  slug          String        @unique
  icon          String        @default("Tag")
  description   String        @default("")
  image         String        @default("")
  subCategories SubCategory[]
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("categories")
}

model HeroSlide {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tag       String
  title     String
  subtitle  String
  ctaText   String
  ctaLink   String
  image     String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("heroslides")
}

model Order {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  orderId           String          @unique @map("id")
  date              String
  items             OrderItem[]
  subtotal          Float
  discount          Float           @default(0)
  shippingFee       Float           @default(0)
  total             Float
  status            String          @default("Processing")
  shippingAddress   ShippingAddress
  deliveryMethod    String
  paymentMethod     String
  paymentStatus     String          @default("Unpaid")
  bkashSenderNumber String?
  bkashTrxId        String?
  trackingNumber    String?
  estimatedDelivery String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("orders")
}

model Product {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  productId          String         @unique @map("id")
  slug               String         @unique
  name               String
  category           String
  subCategory        String?
  price              Float
  originalPrice      Float
  rating             Float          @default(4.8)
  reviewCount        Int            @default(0)
  isNewArrival       Boolean        @default(false)
  isBestSeller       Boolean        @default(false)
  isFlashSale        Boolean        @default(false)
  discountPercentage Float          @default(0)
  workType           String
  occasion           String
  material           String
  weather            String?        @default("")
  colors             ProductColor[]
  sizes              String[]
  stock              Int            @default(10)
  images             String[]
  description        String
  features           String[]
  careInstructions   String[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("products")
}

model Promotion {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  code          String   @unique
  discountType  String   @default("percentage")
  discountValue Float
  minSpend      Float    @default(0)
  maxDiscount   Float    @default(0)
  usageLimit    Int      @default(100)
  usedCount     Int      @default(0)
  expiryDate    String   @default("2026-12-31")
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("promotions")
}

model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  email        String     @unique
  phone        String
  name         String
  district     String     @default("Dhaka")
  fullAddress  String     @default("")
  passwordHash String     @default("")
  resetOtp     String     @default("")
  cart         CartItem[]
  wishlist     String[]
  ip           String     @default("")
  isBlocked    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}

model Review {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  productId        String
  rating           Int
  comment          String
  images           String[]
  video            String?
  author           String
  verifiedPurchase Boolean  @default(true)
  orderId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("reviews")
}

model SystemSettings {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  deliveryFeeInsideDhaka   Float    @default(60)
  deliveryFeeOutsideDhaka  Float    @default(120)
  freeShippingMinSpend     Float    @default(3000)
  adminBkashNumber         String   @default("01700000000")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("systemsettings")
}
