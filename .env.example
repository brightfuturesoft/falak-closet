# ==============================================================================
# APPLICATION & SERVER CONFIGURATION
# ==============================================================================
# Port for the main Next.js web application (default: 3000)
PORT=3000

# Base public URL of the application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Socket server URL for real-time order & dashboard updates (default: http://localhost:3001)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Port for standalone socket server (default: 3001)
SOCKET_PORT=3001

# ==============================================================================
# DATABASE CONFIGURATION (MongoDB & Prisma)
# ==============================================================================
# MongoDB Connection String for Prisma ORM
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# ==============================================================================
# AUTHENTICATION & ADMIN CREDENTIALS
# ==============================================================================
# Secret key used for signing session tokens and cookies
AUTH_SECRET=your-random-32-character-auth-secret-key

# Admin portal credentials
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password

# ==============================================================================
# CLOUDINARY MEDIA STORAGE
# ==============================================================================
# Cloudinary cloud name for client-side image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Full Cloudinary API connection string (format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=cloudinary://1234567890:your_api_secret@your_cloudinary_cloud_name

# ==============================================================================
# PATHAO COURIER API & WEBHOOKS
# ==============================================================================
# Pathao API base URL (Production: https://api-hermes.pathao.com | Sandbox: https://courier-sandbox.pathao.com)
PATHAO_BASE_URL=https://api-hermes.pathao.com

# Pathao Merchant API credentials
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_USERNAME=your_pathao_account_email
PATHAO_PASSWORD=your_pathao_account_password

# Optional store ID (if using a specific store location)
PATHAO_STORE_ID=

# Webhook secret key to verify Pathao webhook callbacks
PATHAO_WEBHOOK_SECRET=your_pathao_webhook_secret

# ==============================================================================
# STEADFAST COURIER API (OPTIONAL)
# ==============================================================================
STEADFAST_USER=your_steadfast_user_email
STEADFAST_PASSWORD=your_steadfast_password
